<Window
    x:Class="MolHub.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MolHub.Windows"
    Title="">
    <Grid x:Name="RootGrid" Background="{ThemeResource MolHubSurfaceBrush}"
          SizeChanged="RootGrid_SizeChanged" Loaded="RootGrid_Loaded"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <!-- Account-menu style flyout: no presenter padding, 8px corners and a transparent surface so the acrylic backdrop shows through. -->
            <Style x:Key="AcrylicFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Style>
            <Style x:Key="FlyoutMenuRowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar x:Name="AppTitleBar"
                           Grid.Row="0"
                           Height="48"
                           VerticalContentAlignment="Center"
                           Title=""
                           Subtitle=""
                           IsBackButtonVisible="False"
                           IsBackButtonEnabled="False"
                           BackRequested="AppTitleBar_BackRequested"
                           AutomationProperties.Name="">
            <controls:TitleBar.Content>
                <AutoSuggestBox x:Name="PageSearchBox"
                                Width="96"
                                Height="32"
                                MinWidth="96"
                                MaxWidth="540"
                                Visibility="Visible"
                                VerticalAlignment="Center"
                                PlaceholderText=""
                                QuerySubmitted="PageSearchBox_QuerySubmitted"
                                TextChanged="PageSearchBox_TextChanged"
                                AutomationProperties.Name="">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="PageSearchKeyboardAccelerator_Invoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </controls:TitleBar.Content>
            <controls:TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="NotificationsButton" Width="32" Height="32" MinWidth="32" MinHeight="32"
                            VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0" Padding="0" CornerRadius="6" Click="NotificationsButton_Click"
                            ToolTipService.ToolTip="" AutomationProperties.Name="">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA8F;" FontSize="18" AutomationProperties.AccessibilityView="Raw" />
                        <Button.Flyout>
                            <Flyout x:Name="NotificationsFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False"
                                    FlyoutPresenterStyle="{StaticResource AcrylicFlyoutPresenterStyle}">
                                <Flyout.SystemBackdrop>
                                    <local:ThinAcrylicBackdrop />
                                </Flyout.SystemBackdrop>
                                <Grid Width="360" MaxHeight="440">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="NotificationsHeader" Text="" Padding="20,16,20,14" AutomationProperties.HeadingLevel="Level1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="NotificationsEmpty" Text="" TextWrapping="Wrap" Margin="20,12,20,16"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </ScrollViewer>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ProfileButton" Width="32" Height="32" MinWidth="32" MinHeight="32"
                            VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0" Padding="0" CornerRadius="16" Click="ProfileButton_Click"
                            ToolTipService.ToolTip="" AutomationProperties.Name="">
                        <PersonPicture x:Name="ProfilePicture" Width="28" Height="28" DisplayName="" AutomationProperties.AccessibilityView="Raw" />
                        <Button.Flyout>
                            <Flyout x:Name="AccountFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False"
                                    FlyoutPresenterStyle="{StaticResource AcrylicFlyoutPresenterStyle}">
                                <Flyout.SystemBackdrop>
                                    <local:ThinAcrylicBackdrop />
                                </Flyout.SystemBackdrop>
                                <ScrollViewer Width="320" MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="0,0,0,6">
                                        <Grid Padding="14,14,16,12" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <PersonPicture x:Name="AccountPicture" Width="48" Height="48" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="1">
                                                <TextBlock x:Name="AccountName" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock x:Name="AccountStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="·" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock x:Name="AccountRole" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button x:Name="SignOutButton" Margin="-6,4,0,0" Padding="6,3" MinHeight="0"
                                                        Background="Transparent" BorderThickness="0" Click="SignOut_Click">
                                                    <TextBlock x:Name="SignOutLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Border x:Name="AccountSeparator" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Button x:Name="ProfileSettingsButton" Margin="0,6,0,0" Style="{StaticResource FlyoutMenuRowButtonStyle}" Click="ProfileSettings_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <FontIcon Glyph="&#xE77B;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock x:Name="ProfileSettingsLabel" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AdministrationButton" Style="{StaticResource FlyoutMenuRowButtonStyle}" Click="Administration_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <FontIcon Glyph="&#xE7EF;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock x:Name="AdministrationLabel" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </controls:TitleBar.RightHeader>
        </controls:TitleBar>

        <NavigationView x:Name="Navigation"
                        Grid.Row="1"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="False"
                        SelectionChanged="Navigation_SelectionChanged"
                        AutomationProperties.Name="">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="" Tag="Dashboard"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="" Tag="Projects"><NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="" Tag="CommitHistory"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="" Tag="ProjectManagement"><NavigationViewItem.Icon><SymbolIcon Symbol="Manage" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="" Tag="AwaitingApproval"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="MaintenanceItem" Content="" Tag="ServerMaintenance"><NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="" Tag="AppSettings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="" Tag="VersionInfo"><NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ContentControl x:Name="ContentFrame" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="40" />
                    </TransitionCollection>
                </ContentControl.ContentTransitions>
            </ContentControl>
        </NavigationView>

    </Grid>
</Window>
