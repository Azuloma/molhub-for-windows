<Application
    x:Class="MolHub.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MolHub.Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MolHubAccentBrush" Color="#B83E47" />
                    <SolidColorBrush x:Key="MolHubAccentForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MolHubAccentSubtleBrush" Color="#1AB83E47" />
                    <SolidColorBrush x:Key="MolHubChromeBrush" Color="#F7F4F4" />
                    <SolidColorBrush x:Key="MolHubSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MolHubChannelBadgeBackgroundBrush" Color="#E8F1FB" />
                    <SolidColorBrush x:Key="MolHubChannelBadgeBorderBrush" Color="#8DB4E2" />
                    <SolidColorBrush x:Key="MolHubChannelBadgeForegroundBrush" Color="#0F4C8A" />
                    <BitmapImage x:Key="MolHubBannerImage" UriSource="ms-appx:///Assets/MolHubBannerOnLight.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MolHubAccentBrush" Color="#EF7C82" />
                    <SolidColorBrush x:Key="MolHubAccentForegroundBrush" Color="#3A1114" />
                    <SolidColorBrush x:Key="MolHubAccentSubtleBrush" Color="#25EF7C82" />
                    <SolidColorBrush x:Key="MolHubChromeBrush" Color="#2A2223" />
                    <SolidColorBrush x:Key="MolHubSurfaceBrush" Color="#20191A" />
                    <SolidColorBrush x:Key="MolHubChannelBadgeBackgroundBrush" Color="#1E2B3C" />
                    <SolidColorBrush x:Key="MolHubChannelBadgeBorderBrush" Color="#3E6490" />
                    <SolidColorBrush x:Key="MolHubChannelBadgeForegroundBrush" Color="#CFE3FF" />
                    <BitmapImage x:Key="MolHubBannerImage" UriSource="ms-appx:///Assets/MolHubBannerOnDark.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <!-- Use the OS-provided high-contrast highlight pair; never hard-code
                         both badge foreground and background to the same color. -->
                    <StaticResource x:Key="MolHubAccentBrush" ResourceKey="SystemControlHighlightAltAccentBrush" />
                    <StaticResource x:Key="MolHubAccentForegroundBrush" ResourceKey="SystemControlHighlightAltAccentBrush" />
                    <StaticResource x:Key="MolHubAccentSubtleBrush" ResourceKey="SystemControlHighlightAccentBrush" />
    <StaticResource x:Key="MolHubChromeBrush" ResourceKey="SystemControlPageBackgroundChromeLowBrush" />
    <StaticResource x:Key="MolHubSurfaceBrush" ResourceKey="SystemControlPageBackgroundBaseLowBrush" />
                    <StaticResource x:Key="MolHubChannelBadgeBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="MolHubChannelBadgeBorderBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="MolHubChannelBadgeForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <BitmapImage x:Key="MolHubBannerImage" UriSource="ms-appx:///Assets/MolHubBannerOnDark.png" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="MolHubSpacing4">4</x:Double>
            <x:Double x:Key="MolHubSpacing8">8</x:Double>
            <x:Double x:Key="MolHubSpacing12">12</x:Double>
            <x:Double x:Key="MolHubSpacing16">16</x:Double>
            <x:Double x:Key="MolHubSpacing24">24</x:Double>
            <x:Double x:Key="MolHubSpacing40">40</x:Double>

            <!-- Dashboard building blocks. Pages are built in code, so ThemeResource lookups live in these styles
                 and follow the RootGrid theme (Light, Dark or High Contrast). -->
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="DashboardDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="DashboardSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DashboardCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DashboardAccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource MolHubAccentBrush}" />
            </Style>
            <Style x:Key="DashboardIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DashboardVersionBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MolHubAccentSubtleBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DashboardVersionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource MolHubAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="DashboardIdChipStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DashboardIdTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Version info: banner logo, hero texts, channel badge, row icons and the bridge status indicator. -->
            <Style x:Key="VersionBannerImageStyle" TargetType="Image">
                <Setter Property="Source" Value="{ThemeResource MolHubBannerImage}" />
                <Setter Property="Stretch" Value="Uniform" />
            </Style>
            <Style x:Key="VersionHeroLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="VersionHeroNumberStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="56" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
                <Setter Property="LineHeight" Value="64" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="VersionChannelBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MolHubChannelBadgeBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MolHubChannelBadgeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="VersionChannelBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource MolHubChannelBadgeForegroundBrush}" />
            </Style>
            <Style x:Key="VersionInfoRowIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="VersionStatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="VersionStatusSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VersionStatusTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="VersionStatusCautionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VersionStatusTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="VersionStatusCriticalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VersionStatusTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="VersionStatusSuccessBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="VersionStatusSuccessGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="VersionStatusCautionGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="VersionStatusCriticalGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="VersionHeroDividerStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- Projects: private label and the reservation status (Available for work / Working). -->
            <Style x:Key="ProjectPrivateBadgeStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,1,8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ProjectStatusAvailableDotStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="ProjectStatusWorkingDotStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="ProjectStatusAvailableTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="ProjectStatusWorkingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Administration Members: Reject and Suspend in the overflow menu (they remove normal access). -->
            <Style x:Key="AdminDangerMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <!-- Project management: a form's own check result under its fields (cleared as the user edits). -->
            <Style x:Key="ManageFieldErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
